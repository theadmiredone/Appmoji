{
  "name": "appmoji",
  "version": "0.1.0",
  "private": true,
  "description": "Guild-scoped Discord slash commands for managing application-owned emojis.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "npm run build && npm run deploy:commands && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@discordjs/rest": "^2.5.1",
    "discord-api-types": "^0.38.35",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
