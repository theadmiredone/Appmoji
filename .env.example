# Discord application ID from the Developer Portal.
DISCORD_APPLICATION_ID=123456789012345678
# Bot token. Keep this secret and never commit .env.
DISCORD_TOKEN=replace_me
# Comma-separated guilds in which to register Appmoji's commands.
DISCORD_GUILD_IDS=123456789012345678
# Optional: comma-separated IDs allowed to manage emojis even without Administrator.
APP_EMOJI_MANAGER_USER_IDS=
# Optional: comma-separated role IDs allowed to manage emojis even without Administrator.
APP_EMOJI_MANAGER_ROLE_IDS=
