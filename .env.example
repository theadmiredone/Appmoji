# Discord application ID from the Developer Portal.
APPLICATION_ID=123456789012345678
# Bot token. Keep this secret and never commit .env.
APP_TOKEN=replace_with_your_bot_token
# Comma-separated guilds in which to register Appmoji's commands.
GUILD_IDS=123456789012345678,234567890123456789
# Optional: users allowed to manage emojis without Administrator.
# Use a comma between IDs. Spaces are optional and are ignored.
USER_ID=345678901234567890,456789012345678901
# Optional: roles allowed to manage emojis without Administrator.
# Use a comma between IDs. Spaces are optional and are ignored.
ROLE_ID=567890123456789012,678901234567890123
